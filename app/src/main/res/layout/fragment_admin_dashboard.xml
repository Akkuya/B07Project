<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/adminDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Admin Dashboard"
        android:textSize="25sp"
        android:textStyle="bold"
        android:paddingHorizontal="5sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp" />

    <Button
        android:id="@+id/browseArtifactsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Browse Artifacts"
        android:layout_marginTop="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/adminDashboardTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/addArtifactButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Artifact"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/browseArtifactsButton"
        app:layout_constraintStart_toStartOf="@id/browseArtifactsButton"
        app:layout_constraintEnd_toEndOf="@id/browseArtifactsButton" />

</androidx.constraintlayout.widget.ConstraintLayout>